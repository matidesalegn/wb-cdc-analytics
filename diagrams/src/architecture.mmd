%% Architecture. Rendered by `make render`, and also embedded as a fenced mermaid block
%% in the README, which GitHub renders natively so no toolchain is needed to read it.
%% .
%% LAYOUT NOTE. The outer direction is TB with each stage as an inner LR band, rather than
%% one long LR chain. An LR chain rendered at 2.5:1, which left 40 percent of the canvas
%% empty and, more importantly, shrank to unreadable text when scaled to the width of a PDF
%% page. Stacked bands give a roughly square figure that stays legible in print.
%% .
%% EDGE DIRECTION IS LOAD BEARING. Every orchestration edge points INTO the pipeline, and
%% that is not a layout trick: Airflow triggers and builds, and Prometheus SCRAPES, because
%% it is pull based. Drawing telemetry as arrows from the monitored node into Prometheus was
%% both backwards and a cycle, since dbt build already pointed the other way, and a cycle
%% between two subgraphs is resolved arbitrarily: it rendered the stages as 5, 3, 1, 2, 4
%% down the page. One consistent direction gives a readable ranking.
flowchart TB
    subgraph src["1. Source"]
        direction LR
        API["World Bank Indicators API v2<br/>public, no auth<br/>page / per_page pagination"]
    end

    subgraph oltp["2. OLTP: PostgreSQL 17"]
        direction LR
        ING["ingest<br/>pagination, retry with jitter,<br/>envelope validation, pre-load gate"]
        WB[("wb.country<br/>wb.indicator<br/>wb.observation<br/><i>natural keys as PKs</i>")]
        OPS[("ops.ingest_run<br/>ops.ingest_watermark<br/>ops.ingest_reject<br/><i>not replicated</i>")]
        HB[("wb.cdc_heartbeat<br/><i>slot keepalive</i>")]
        ING -->|"change-detecting upsert<br/>data + watermark, one txn"| WB
        ING --> OPS
    end

    subgraph orch["Orchestration and observability (cross-cutting)"]
        direction LR
        AF["Airflow<br/>gates: parity, CDC lag,<br/>source health, reconciliation"]
        PROM["Prometheus<br/>10 tested alert rules"]
        GRAF["Grafana<br/>provisioned, 9 panels"]
        PROM --> GRAF
    end

    subgraph cdc["3. CDC transport"]
        direction LR
        DBZ["Debezium 3.6.1<br/>pgoutput, explicit publication"]
        RP[["Redpanda<br/>wbcdc.wb.*"]]
        DBZ --> RP
    end

    subgraph olap["4. OLAP: ClickHouse 25.8"]
        direction LR
        KE["Kafka engine tables<br/><i>JSONAsString: typing<br/>cannot stall the consumer</i>"]
        MV{{"materialized views<br/>JSONExtract only"}}
        LOG[("raw.cdc_event_log<br/>ReplacingMergeTree on<br/>topic/partition/offset<br/><i>at-least-once made convergent</i>")]
        RAW[("raw.country / indicator / observation<br/>ReplacingMergeTree(_version, _is_deleted)<br/><i>_version = Postgres LSN</i>")]
        STG["staging.stg_*<br/><i>views: FINAL + tombstone<br/>filter, in one macro</i>"]
        MARTS[("marts.dim_country<br/>marts.dim_indicator<br/>marts.fct_indicator_observation<br/>marts.agg_country_year_features")]
        KE --> MV
        MV --> LOG
        MV --> RAW
        RAW --> STG
        STG -->|dbt| MARTS
    end

    %% The data path.
    API -->|"HTTPS, 36 paginated requests"| ING
    WB -.->|"WAL, logical decoding"| DBZ
    HB -.->|"10s timer"| DBZ
    RP --> KE

    %% Control and telemetry. Every edge names a specific node rather than a subgraph: an
    %% edge to a subgraph is routed around all of its members, which is what produced the
    %% sweeping lines in the previous version, and it is vaguer about what is measured.
    AF ==>|triggers| ING
    AF ==>|"dbt build"| STG
    PROM -.->|"scrapes slot WAL bytes"| WB
    PROM -.->|"scrapes CDC lag, parity"| RAW
    PROM -.->|"scrapes rows per layer"| MARTS

    classDef store fill:#e8f0fe,stroke:#4285f4,stroke-width:1px
    classDef proc fill:#fff4e5,stroke:#f9ab00,stroke-width:1px
    class WB,OPS,HB,LOG,RAW,MARTS store
    class ING,DBZ,STG,AF proc
