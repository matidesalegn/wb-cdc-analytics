# ---------------------------------------------------------------------------
# Template for .env. Copy with `make env`, which replaces every
# CHANGEME_GENERATED placeholder with a fresh random secret so this repository
# never ships a credential and still starts with one command.
#
# Host ports are deliberately non-default (5xxxx range) so the stack cannot
# collide with a Postgres, Grafana or Airflow already running on the
# reviewer's machine. Every host port binds to 127.0.0.1 only.
# ---------------------------------------------------------------------------

# --- Source REST API -------------------------------------------------------
# World Bank Indicators API v2. No authentication required, public endpoint.
WB_API_BASE=https://api.worldbank.org/v2
WB_COUNTRIES=TCD;ETH;KEN;RWA;SSD
WB_PER_PAGE=100
WB_REQUEST_TIMEOUT_SECONDS=30
WB_MAX_RETRIES=5
# live reads the public API; fixture replays committed JSON so the pipeline is
# runnable with no network. CI always uses fixture.
SOURCE_API_MODE=live

# --- PostgreSQL OLTP (the CDC source) --------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wbsource
POSTGRES_USER=wbapp
POSTGRES_PASSWORD=CHANGEME_GENERATED
POSTGRES_HOST_PORT=55432

# Dedicated replication role for Debezium. Separate from the application role
# so the CDC connector holds REPLICATION and nothing else.
PG_REPL_USER=debezium
PG_REPL_PASSWORD=CHANGEME_GENERATED
PG_PUBLICATION=wb_cdc_pub
PG_REPL_SLOT=wb_cdc_slot

# --- Redpanda (Kafka API) --------------------------------------------------
REDPANDA_BROKER=redpanda:9092
REDPANDA_KAFKA_HOST_PORT=59092
REDPANDA_ADMIN_HOST_PORT=59644
REDPANDA_CONSOLE_HOST_PORT=58090

# --- Debezium Kafka Connect ------------------------------------------------
CONNECT_HOST=connect
CONNECT_PORT=8083
CONNECT_HOST_PORT=58083
CONNECT_CONNECTOR_NAME=pg-wb-source
# Debezium 3.x calls this topic.prefix. Topics become <prefix>.<schema>.<table>.
CDC_TOPIC_PREFIX=wbcdc

# --- ClickHouse OLAP -------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=CHANGEME_GENERATED
CLICKHOUSE_HTTP_HOST_PORT=58123
CLICKHOUSE_NATIVE_HOST_PORT=59001
# Native Prometheus endpoint, enabled in observability/clickhouse/prometheus.xml
CLICKHOUSE_METRICS_PORT=9363

# --- Airflow ---------------------------------------------------------------
AIRFLOW_HOST_PORT=58080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGEME_GENERATED
AIRFLOW_FERNET_KEY=CHANGEME_FERNET
AIRFLOW_METADB_USER=airflow
AIRFLOW_METADB_PASSWORD=CHANGEME_GENERATED
AIRFLOW_METADB_NAME=airflow

# --- Observability ---------------------------------------------------------
PROMETHEUS_HOST_PORT=59090
GRAFANA_HOST_PORT=53000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_GENERATED

# --- Pipeline thresholds (also the alert thresholds) -----------------------
# Max acceptable end-to-end CDC lag before the DAG gate fails and the
# CdcLagHigh alert fires.
CDC_LAG_ERROR_SECONDS=300
# Max acceptable retained WAL on the replication slot. This is the failure mode
# where a forgotten slot fills the source disk.
CDC_SLOT_LAG_ERROR_BYTES=1073741824
