# Secrets. This entry exists in the first commit so no generated .env can ever
# reach history. `make env` writes .env from .env.example.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
.user.yml

# Airflow (only ever written inside the container, but guard the host too)
airflow.db
airflow-webserver.pid
standalone_admin_password.txt
logs/

# Images: ignore every image anywhere, then re-include diagrams/.
#
# The default is deny because pasted screenshots land in the repository root and
# a stray one in a public repository is a leak, not just clutter. The only images
# this project commits deliberately are the rendered architecture and ERD exports
# that `make render` produces from diagrams/src/*.mmd.
#
# Re-inclusion works here only because the exclusions are by file extension and
# never by directory: git cannot re-include a file whose parent directory is
# itself excluded.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.bmp
*.ico
*.avif
*.tiff
*.tif
!diagrams/**

# Rendered diagram exports. The .mmd source is committed and so are the exports,
# so only stray render output is ignored.
#
# This rule MUST stay below the `!diagrams/**` above. The last matching pattern
# in a .gitignore wins, so putting the re-inclusion after this line would
# silently start tracking scratch renders.
diagrams/exports/tmp/

# Local scratch
*.local
.DS_Store
artifacts/
